      "comment": "Contact de retour du contacteur"
    },
    {
      "name": "BP_Reset",
      "type": "BOOL",
      "address": "%I0.4",
      "comment": "Remise à zéro du compteur"
    },
    {
      "name": "Moteur_Convoyeur",
      "type": "BOOL",
      "address": "%Q0.0",
      "comment": "Contacteur moteur"
    },
